{
  "name": "deepseek-balance-badge",
  "version": "1.0.0",
  "description": "Show the DeepSeek account balance at the foot of the DSH sidebar while the open session runs a DeepSeek model.",
  "type": "module",
  "license": "MIT",
  "author": "Temila",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "balance",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Temila/deepseek-balance-badge.git"
  },
  "homepage": "https://github.com/Temila/deepseek-balance-badge#readme",
  "bugs": {
    "url": "https://github.com/Temila/deepseek-balance-badge/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-account"
      ]
    }
  }
}
